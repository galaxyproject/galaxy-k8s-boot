# Example inventory for image preparation

[image_targets]
# Instance IP Example (replace with your actual instance):
# 34.123.456.789

[image_targets:vars]
# Use 'debian' for Debian images, 'ubuntu' for Ubuntu images
ansible_user='debian'
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
ansible_python_interpreter=/usr/bin/python3
