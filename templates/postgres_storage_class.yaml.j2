apiVersion: v1
kind: Namespace
metadata:
  name: postgres-storage
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: local-path-provisioner-service-account
  namespace: postgres-storage
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: postgres-provisioner-role
rules:
- apiGroups: [""]
  resources: ["nodes", "persistentvolumeclaims", "configmaps"]
  verbs: ["get", "list", "watch"]
- apiGroups: [""]
  resources: ["endpoints", "persistentvolumes", "pods"]
  verbs: ["*"]
- apiGroups: [""]
  resources: ["events"]
  verbs: ["create", "patch"]
- apiGroups: ["storage.k8s.io"]
  resources: ["storageclasses"]
  verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: postgres-provisioner-bind
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: postgres-provisioner-role
subjects:
- kind: ServiceAccount
  name: local-path-provisioner-service-account
  namespace: postgres-storage
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres-path-provisioner
  namespace: postgres-storage
spec:
  replicas: 1
  selector:
    matchLabels:
      app: postgres-path-provisioner
  template:
    metadata:
      labels:
        app: postgres-path-provisioner
    spec:
      serviceAccountName: local-path-provisioner-service-account
      containers:
      - name: postgres-path-provisioner
        image: rancher/local-path-provisioner:v0.0.19
        imagePullPolicy: IfNotPresent
        command:
        - local-path-provisioner
        - --debug
        - start
        - --config
        - /etc/config/config.json
        volumeMounts:
        - name: config-volume
          mountPath: /etc/config/
        env:
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: PROVISIONER_NAME
          value: rancher.io/postgres-path
      volumes:
        - name: config-volume
          configMap:
            name: local-path-config
---
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: postgres-storage
provisioner: rancher.io/postgres-path
volumeBindingMode: WaitForFirstConsumer
reclaimPolicy: Retain
---
kind: ConfigMap
apiVersion: v1
metadata:
  name: local-path-config
  namespace: postgres-storage
data:
  config.json: |-
        {
                "nodePathMap":[
                {
                        "node":"DEFAULT_PATH_FOR_NON_LISTED_NODES",
                        "paths":["{{ postgres_storage_disk_path }}"]
                }
                ]
        }
  setup: |-
        #!/bin/sh
        while getopts "m:s:p:" opt
        do
            case $opt in
                p)
                absolutePath=$OPTARG
                ;;
                s)
                sizeInBytes=$OPTARG
                ;;
                m)
                volMode=$OPTARG
                ;;
            esac
        done

        # Extract base directory and PVC identifier from absolutePath
        # Path format: /mnt/postgres_storage/pvc-<uuid>_<namespace>_<pvc-name>
        baseDir=$(dirname "${absolutePath}")
        pvcDir=$(basename "${absolutePath}")

        # Extract namespace and pvc-name (everything after the UUID)
        # Pattern: pvc-<uuid>_<namespace>_<pvc-name>
        suffix=$(echo "${pvcDir}" | sed 's/^pvc-[a-f0-9-]*_//')

        if [ -n "${suffix}" ]; then
            # Search for existing directory with same namespace_pvc-name suffix
            existingDir=$(find "${baseDir}" -maxdepth 1 -type d -name "pvc-*_${suffix}" ! -name "${pvcDir}" 2>/dev/null | head -1)

            if [ -n "${existingDir}" ] && [ -d "${existingDir}" ]; then
                # Check if existing directory has data (more than just empty dir)
                if [ "$(ls -A "${existingDir}" 2>/dev/null)" ]; then
                    echo "Found existing data directory: ${existingDir}"
                    echo "Creating PVC symlink: ${absolutePath} -> ${existingDir}"
                    ln -s "${existingDir}" "${absolutePath}"
                    echo "PVC symlink created successfully"
                    exit 0
                fi
            fi
        fi

        # No existing directory found, create new one
        mkdir -m 0777 -p ${absolutePath}
  teardown: |-
        #!/bin/sh
        while getopts "m:s:p:" opt
        do
            case $opt in
                p)
                absolutePath=$OPTARG
                ;;
                s)
                sizeInBytes=$OPTARG
                ;;
                m)
                volMode=$OPTARG
                ;;
            esac
        done

        # If it's a symlink, just remove the symlink (preserve actual data)
        if [ -L "${absolutePath}" ]; then
            echo "Removing symlink only (preserving actual data): ${absolutePath}"
            rm -f "${absolutePath}"
        else
            # Regular directory - remove it
            rm -rf ${absolutePath}
        fi
  helperPod.yaml: |-
        apiVersion: v1
        kind: Pod
        metadata:
          name: helper-pod
        spec:
          containers:
          - name: helper-pod
            image: busybox
